# Example Environment Variables
# Copy this file to .env.development.local and fill in your values

# Backend API Base URL
# - For local development: leave empty or use ""
# API URL for production (set in CI/CD)
VITE_API_BASE_URL=https://mlviz-backend-xxxxxx.a.run.app

# Default configuration file in public/ folder
VITE_CONFIG_FILE=config

# Page title
# - Local development: MLViz (Dev)
# - Test deployment: MLViz (Test)
# - Production: MLViz
VITE_TITLE=mlviz
# Toggle raw point index visibility in SVM tooltips (set to "true" for dev mode)
VITE_SHOW_DEV_INFO=false

# Firebase Console > Project settings > General > Your apps > Web app
# Public web configuration, never service-account credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=(default)
